# Leave DATABASE_URL commented out to use the built-in PGlite database (no Docker needed).
# Uncomment it to use a real Postgres server, e.g. from `docker compose up -d db`.
# DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow"

# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
